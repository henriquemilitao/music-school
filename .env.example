POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# Porta do Postgres no seu computador. Padrão 5432; use 5433 se outro
# projeto (ex: Enfermaria) já estiver usando 5432.
DB_PORT=5432

# Opcional: versão do Postgres no Docker (padrão 15-alpine). Precisa ser igual
# ou mais nova que a da produção pra restaurar dumps (npm run db:restore).
POSTGRES_IMAGE_TAG=15-alpine
