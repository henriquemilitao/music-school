generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  ADMIN
  STUDENT
  TEACHER
}

enum Instrument {
  BATERIA
  PIANO
  VIOLAO
  GUITARRA
}

enum LessonStatus {
  SCHEDULED // aula agendada
  COMPLETED // aula concluída
  CANCELLED // aula cancelada
}

enum PaymentStatus {
  PENDING // aguardando pagamento
  PAID // pago
  OVERDUE // vencido
}

enum PaymentMethod {
  MANUAL_PIX // fallback/emergência — admin confirma na mão
  GATEWAY // fluxo principal (automático via webhook)
}

// ─────────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────────

model School {
  id       String  @id @default(uuid())
  name     String
  slug     String  @unique
  cnpj     String?
  address  String?
  phone    String?
  email    String?
  settings Json? // ex: { "renewalDaysBeforeEnd": 10 }

  // Offset fixo do fuso horário dessa escola em relação ao UTC (ex:
  // -4 pra Mato Grosso do Sul, -3 pra São Paulo). Usado toda vez que
  // o backend precisa converter um horário "local" digitado pelo
  // admin (ex: "aula às 8h") pro timestamp UTC real que fica salvo
  // no banco — sem isso, o sistema não teria como saber que "8h"
  // significa "8h de Campo Grande" e não "8h em Londres".
  // Não lida com horário de verão automaticamente (o Brasil não usa
  // mais desde 2019, então um valor fixo é suficiente por enquanto).
  timezoneOffsetHours Int @default(-4)

  createdAt DateTime @default(now())

  // fallback manual — não usado no fluxo com gateway
  pixKey     String?
  pixKeyType String?

  users          User[]
  lessons        Lesson[]
  payments       Payment[]
  enrollments    Enrollment[]
  paymentBundles PaymentBundle[]

  @@map("schools")
}

model User {
  id           String          @id @default(uuid())
  schoolId     String
  school       School          @relation(fields: [schoolId], references: [id])
  name         String
  email        String          @unique
  passwordHash String? // AGORA OPCIONAL — usuário convidado ainda não tem senha
  invites      AccountInvite[]
  phone        String?
  role         Role            @default(STUDENT)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())

  // NOVO — token do Expo Push (ExponentPushToken[...]) pra mandar
  // notificação. Null se o usuário nunca deu permissão ou nunca
  // abriu o app num device físico.
  pushToken String?

  students       Student[]
  teacher        Teacher?
  paymentBundles PaymentBundle[]

  @@map("users")
}

model AccountInvite {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // hash SHA-256 do token, nunca o token puro
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("account_invites")
}

model Student {
  id         String      @id @default(uuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String // nome do aluno (pode ser diferente do User, ex: pai cadastrando filho)
  birthDate  DateTime? // pra calcular idade
  instrument Instrument?

  notes     String?
  createdAt DateTime @default(now())

  lessons     Lesson[]
  payments    Payment[]
  enrollments Enrollment[]

  @@map("students")
}

model Teacher {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio       String?
  createdAt DateTime @default(now())

  lessons     Lesson[]
  enrollments Enrollment[]

  @@map("teachers")
}

enum LessonFrequency {
  WEEKLY
  BIWEEKLY
}

// Matrícula — define o padrão de recorrência das aulas de um aluno
// E TAMBÉM o padrão de cobrança (quando vence a mensalidade). Esses
// dois ciclos são independentes um do outro: o ciclo de AULAS ancora
// num dia do mês (ex: sempre dia 15), e o ciclo de VENCIMENTO ancora
// em outro dia do mês (ex: sempre dia 10) — um aluno pode começar a
// aula dia 15 mas vencer dia 10, sem relação entre as duas datas.
model Enrollment {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])

  weekDay         Int // 0=domingo, 1=segunda... 6=sábado — derivado de firstLessonDate na criação, nunca digitado direto pelo admin
  startTime       String // horário no formato "15:00"
  durationMinutes Int             @default(60)
  frequency       LessonFrequency @default(WEEKLY)
  monthlyAmount   Decimal         @db.Decimal(10, 2) // valor cheio da mensalidade (sem desconto de pontualidade — o desconto é calculado depois, na hora de gerar o PIX)

  // ── Ciclo de AULAS ──────────────────────────────────────────
  // firstLessonDate: data da primeira aula dessa matrícula. Define
  // duas coisas ao mesmo tempo: (1) o weekDay acima, e (2) o "dia
  // âncora" que o ciclo mensal de aulas vai sempre tentar repetir
  // (ex: se a 1ª aula é dia 15, todo ciclo seguinte também começa
  // no dia 15, ajustando pra baixo só se o mês não tiver esse dia,
  // como fevereiro).
  firstLessonDate DateTime

  // lastLessonPeriodStart: MEMÓRIA interna do sistema (o admin nunca
  // preenche isso) — guarda a data de início do último ciclo de aulas
  // que já foi gerado (aulas criadas + fatura criada) pra essa
  // matrícula. O cron usa isso pra saber "de onde eu continuo" — sem
  // isso, ele não teria como saber se e quando gerou o último período.
  // Fica null até a primeira geração acontecer (na criação da matrícula).
  lastLessonPeriodStart DateTime?

  // ── Ciclo de VENCIMENTO (pagamento) ─────────────────────────
  // firstPaymentDueDate: data do primeiro vencimento da mensalidade,
  // informada pelo admin na criação. INDEPENDENTE de firstLessonDate
  // — pode ser antes, igual, ou depois da primeira aula. Se o admin
  // não informar esse campo na criação (DTO), o service usa
  // firstLessonDate como valor padrão (ver EnrollmentsService.create).
  firstPaymentDueDate DateTime

  // lastPaymentDueDate: MEMÓRIA interna do sistema (equivalente a
  // lastLessonPeriodStart, mas pro lado do vencimento) — guarda a
  // data do último vencimento já gerado. O cron soma 1 mês nisso
  // (mantendo o dia-âncora de firstPaymentDueDate) pra saber a data
  // do PRÓXIMO vencimento a cobrar. Fica null até a primeira geração.
  lastPaymentDueDate DateTime?

  // lastGeneratedPeriodKey: rótulo em TEXTO (ex: "2026-09-15") do
  // último ciclo de aulas já gerado — usado só como parte da
  // idempotencyKey do Payment e pra checar rapidamente "esse período
  // já foi processado?" sem precisar comparar objetos Date. Não é
  // usado em nenhum cálculo de data, só como identificador/trava.
  lastGeneratedPeriodKey String?

  isActive Boolean @default(true) // false = matrícula encerrada, cron nunca mais renova

  createdAt DateTime @default(now())

  lessons  Lesson[]
  payments Payment[]

  @@map("enrollments")
}

model Lesson {
  id           String      @id @default(uuid())
  schoolId     String
  school       School      @relation(fields: [schoolId], references: [id])
  studentId    String
  student      Student     @relation(fields: [studentId], references: [id])
  teacherId    String?
  teacher      Teacher?    @relation(fields: [teacherId], references: [id])
  enrollmentId String? // null = aula avulsa criada manualmente
  enrollment   Enrollment? @relation(fields: [enrollmentId], references: [id])

  scheduledAt     DateTime // data e hora da aula
  durationMinutes Int          @default(60)
  status          LessonStatus @default(SCHEDULED)
  notes           String? // observações pós-aula

  isMakeup     Boolean @default(false) // true = aula de reposição
  cancelReason String? // motivo do cancelamento

  createdAt DateTime @default(now())

  @@map("lessons")
}

model Payment {
  id           String      @id @default(uuid())
  schoolId     String
  school       School      @relation(fields: [schoolId], references: [id])
  studentId    String
  student      Student     @relation(fields: [studentId], references: [id])
  enrollmentId String? // null = pagamento avulso
  enrollment   Enrollment? @relation(fields: [enrollmentId], references: [id])

  amount         Decimal       @db.Decimal(10, 2) // valor cheio da mensalidade (sempre)
  paidAmount     Decimal?      @db.Decimal(10, 2) // NOVO — valor efetivamente cobrado no PIX gerado (com ou sem desconto). Null até o primeiro PIX ser gerado.
  dueDate        DateTime // vencimento desta fatura específica — copiado de Enrollment.firstPaymentDueDate (1ª fatura) ou calculado pelo cron a partir de lastPaymentDueDate (renovações)
  paidAt         DateTime? // preenchido quando confirmar pagamento
  status         PaymentStatus @default(PENDING)
  referenceMonth String // rótulo do mês desta fatura, ex: "2026-09". Informado pelo admin na criação (opcional) OU calculado automaticamente a partir do mês de dueDate quando o admin não informar

  paymentMethod PaymentMethod @default(GATEWAY)
  provider      String? // "infinitepay" | "abacatepay" | "manual"
  checkoutUrl   String? // link de pagamento gerado pelo gateway
  externalId    String? // id da transação no gateway
  pixCopyPaste  String?
  pixQrCode     String?
  pixExpiresAt  DateTime? // NOVO — quando o PIX atual expira

  webhookReceivedAt DateTime? // auditoria: quando a confirmação automática chegou

  // fluxo manual/fallback
  proofUrl    String? // comprovante anexado pelo admin
  confirmedBy String? // id do admin que confirmou manualmente

  idempotencyKey String @unique // studentId+referenceMonth — evita duplicar cobrança

  createdAt       DateTime       @default(now())
  paymentBundle   PaymentBundle? @relation(fields: [paymentBundleId], references: [id])
  paymentBundleId String?

  @@map("payments")
}

enum BundleStatus {
  PENDING
  PAID
  CANCELLED
}

model PaymentBundle {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])
  userId   String // o responsável que está pagando (Payment.student.userId em comum)
  user     User   @relation(fields: [userId], references: [id])

  amount Decimal      @db.Decimal(10, 2) // soma das faturas cobertas
  status BundleStatus @default(PENDING)
  paidAt DateTime?

  provider     String? // "abacatepay"
  externalId   String? // id da cobrança no gateway
  pixCopyPaste String?
  pixQrCode    String?
  pixExpiresAt DateTime? // NOVO

  idempotencyKey String @unique // hash das faturas cobertas — evita duplicar

  createdAt DateTime @default(now())

  payments Payment[] // faturas cobertas por esse bundle

  @@map("payment_bundles")
}
