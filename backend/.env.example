APP_URL=

# Porta da API (padrão 3000). Se o Enfermaria já usa 3000, use 3001 e
# rode o app com: EXPO_PUBLIC_API_PORT=3001 npm run start:phone
PORT=3000

# Mesmos dados do .env da raiz; a porta é a DB_PORT.
# Ex: postgresql://USUARIO:SENHA@localhost:5432/NOME_DO_BANCO?schema=public
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=

RENEWAL_DAYS_BEFORE_START=

ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=       


# Se precidas: public key TEST-01a5eaa4-d247-40e9-a2a7-3d230600b016

